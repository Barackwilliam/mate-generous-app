# Copy to backend/.env for local development. Never commit the real .env.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
DJANGO_CSRF_TRUSTED_ORIGINS=
# Leave empty locally to use SQLite. In production: the Supabase "Session pooler" URL.
DATABASE_URL=
CORS_ALLOWED_ORIGINS=
# Web page that shared excerpts link to.
SHARE_BASE_URL=https://example.com
# sandbox | <real gateway once chosen>
PAYMENT_GATEWAY=sandbox
PAYMENT_CALLBACK_SECRET=change-me-too
# Only for a staging server that should take fake payments.
ALLOW_SANDBOX_PAYMENTS=0
